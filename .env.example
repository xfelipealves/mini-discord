STORAGE_MODE=local
LOCAL_DATA_FILE=./data/chat.json
API_PORT=3000
REQUEST_BODY_LIMIT=32kb
# Optional explicit Scylla mode requires an initialized keyspace and messages table.
SCYLLA_CONTACT_POINTS=127.0.0.1
SCYLLA_DATACENTER=datacenter1
SCYLLA_KEYSPACE=chat
DEFAULT_WRITE_CONSISTENCY=ONE
DEFAULT_READ_CONSISTENCY=ONE
