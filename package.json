{
  "name": "mini-discord-scylladb",
  "version": "1.0.0",
  "description": "Mini chat application to validate ScyllaDB concepts",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc",
    "test": "npm run test:unit && npm run test:frontend",
    "test:watch": "jest --watch",
    "test:integration": "npm run test:scylla",
    "test:scylla": "jest --runInBand --testPathPatterns=integration",
    "test:unit": "jest --runInBand",
    "test:frontend": "node --test tests/frontend/chat-core.test.mjs"
  },
  "dependencies": {
    "cassandra-driver": "^4.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.1",
    "@types/node-fetch": "^2.6.11",
    "@types/supertest": "^6.0.3",
    "jest": "^30.5.2",
    "node-fetch": "^2.7.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.7.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=20"
  }
}
